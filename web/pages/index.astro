---
import Layout from "../layouts/Layout.astro";
import LogoURL from "@scrap/assets/svgs/scrap.svg?url";
import TypeScript from "../assets/code.ts?shiki";
import Blocks from "../assets/code.svg";
import {author} from "../../package.json";
import MenuIcon from "@material-symbols/svg-400/rounded/menu.svg?icon";
import BoltIcon from "@material-symbols/svg-400/rounded/bolt-fill.svg?icon";
import SyncAltIcon from "@material-symbols/svg-400/rounded/sync_alt.svg?icon";
import PaletteIcon from "@material-symbols/svg-400/rounded/palette.svg?icon";
import HTMLIcon from "@material-symbols/svg-400/rounded/html.svg?icon";
import GlobeIcon from "@material-symbols/svg-400/rounded/globe.svg?icon";
import Demo from "@scrap/components/parts/CodePanel.svelte";
import Button from "@scrap/components/controls/Button.svelte";
import ScrapLogo from "@scrap/assets/svgs/scrap.svg?icon";
---

<Layout
	title="Scrap – Visual Programming Editor for All Creators"
	description="Scrap is a revolutionary visual programming editor that combines intuitive block-based coding with the full power of TypeScript. Perfect for creators of all levels."
>
	<nav class="navbar bg-base-100" style:zoom="80%">
		<div class="navbar-start">
			<Button variant="ghost">
				<ScrapLogo aria-label="Scrap" client:visible class="h-8" />
			</Button>
		</div>
		<div class="navbar-end">
			<MenuIcon client:visible fill="white" height={24} width={24} />
		</div>
	</nav>
	<header class="hero bg-base-200 min-h-screen">
		<div class="hero-content text-center">
			<div class="max-w-lg">
				<h1 class="font-bold">
					<ScrapLogo aria-label="Scrap" client:visible class="w-60 mx-auto" />
				</h1>
				<p class="py-6">
					Scrap is an intuitive editor for building interactive projects using
					block-based programming, inspired by Scratch but with the full power of
					TypeScript. Start creating, learning, and prototyping faster than ever
					before!
				</p>
				<a href="/app" class="btn btn-primary">Get Started</a>
			</div>
		</div>
	</header>
	<section class="container p-4">
		<h2 class="text-center text-3xl mb-8 mt-1">Main features</h2>
		<ul class="list mb-8 mx-auto w-fit">
			<li class="list-row">
				<div>
					<div
						class="size-10 rounded-box bg-primary flex items-center justify-center"
					>
						<BoltIcon client:visible class="size-8 fill-primary-content" />
					</div>
				</div>
				<div>
					<div>Block-based programming</div>
					<div class="text-xs uppercase font-semibold opacity-60">
						with TypeScript switch
					</div>
				</div>
			</li>

			<li class="list-row">
				<div class="size-10 rounded-box bg-primary flex items-center justify-center">
					<PaletteIcon client:visible class="size-8 fill-primary-content" />
				</div>
				<div>
					<div>Paint editor built in</div>
					<div class="text-xs uppercase font-semibold opacity-60">
						Now via Painterro
					</div>
				</div>
			</li>

			<li class="list-row">
				<div class="size-10 rounded-box bg-primary flex items-center justify-center">
					<SyncAltIcon client:visible class="size-8 fill-primary-content" />
				</div>
				<div>
					<div>Compatible with Scratch 3</div>
					<div class="text-xs uppercase font-semibold opacity-60">
						* Minor incompatibilities
					</div>
				</div>
			</li>

			<li class="list-row">
				<div class="size-10 rounded-box bg-primary flex items-center justify-center">
					<GlobeIcon client:visible class="size-8 fill-primary-content" />
				</div>
				<div>
					<div>Open source</div>
					<div class="text-xs uppercase font-semibold opacity-60">
						Code hosted on GitHub
					</div>
				</div>
			</li>

			<li class="list-row">
				<div class="size-10 rounded-box bg-primary flex items-center justify-center">
					<HTMLIcon client:visible class="size-8 fill-primary-content" />
				</div>
				<div>
					<div>Export and use outside of Scrap</div>
					<div class="text-xs uppercase font-semibold opacity-60">
						Run HTML on your PC
					</div>
				</div>
			</li>
		</ul>
	</section>

	<section id="hero">
		<div class="container">
			<h1 style={`content: url('${LogoURL}');`}>Scrap</h1>
			<p class="subtitle">A revolutionary visual programming editor for all creators</p>
			<p class="description">
				Scrap is an intuitive editor for building interactive projects using block-based
				programming, inspired by Scratch but with the full power of TypeScript. Start
				creating, learning, and prototyping faster than ever before!
			</p>
		</div>
	</section>

	<section id="features">
		<div class="container">
			<h2>Main Features</h2>
			<ul>
				<li class="with-asterisk">⚡ Block-based programming with TypeScript switch</li>
				<li>🎨 Built-in image editor</li>
				<li class="with-asterisk">🔌 Compatible with Scratch 3</li>
				<li>🌐 Open source</li>
				<li>🚀 Export and use outside of Scrap</li>
			</ul>
			<small>* partial incompatibility</small>
		</div>
	</section>

	<section id="about">
		<div class="container">
			<h2>What Makes Scrap Unique?</h2>
			<p>
				Scrap is a unique visual programming environment that helps users transition
				from block-based to text-based coding. It offers a
				<strong
					>seamless switch between a block editor and a TypeScript code editor</strong
				>, ensuring a smooth learning curve for anyone interested in programming.
			</p>
			<h3>Type Safety:</h3>
			<p>
				Scrap enforces type safety in both the block and code editors, preventing
				incompatible connections and invalid code. Most platforms do not teach about
				types &ndash; which is crucial for real-world programming &ndash; but Scrap does
				it right from the start.
			</p>
			<h3>Scratch-like blocks:</h3>
			<p>
				Many <a
					href="https://developers.google.com/blockly"
					target="_blank"
					rel="noopener">Blockly</a
				> applications offer block-based programming, but do not use Scratch-like blocks.
				Scrap uses a
				<a href="https://scratch.mit.edu/" target="_blank" rel="noopener">Scratch</a
				>-like block design, making it familiar to millions of users. Scrap still
				manages to make the blocks more powerful, though. Take a look at this <code
					>if</code
				> block, for example:
			</p>
			<div id="blockly" style="width: 100%; aspect-ratio: 16 / 9; margin: 1rem 0;"></div>
			<h3>Native Code:</h3>
			<p>
				Unlike other platforms, Scrap compiles your code directly to JavaScript, so your
				projects can run on any device. You can even export them as standalone HTML
				files to share with others.
			</p>
			<h3>Powered by the VSCode's core:</h3>
			<p>
				The code editor is built on an extended version of the Monaco Editor, providing
				features like
				<strong> TypeScript IntelliSense</strong>, syntax highlighting that mirrors
				block colors, and warnings for block-incompatible code.
			</p>
		</div>
	</section>

	<section id="compare">
		<div class="container compare-flex">
			<h2>Learn by Comparing</h2>
			<p class="compare-lead">
				Scrap lets you seamlessly switch between block-based programming and TypeScript
				code. This unique approach helps you understand how visual blocks translate to
				real code, making programming more accessible and educational for everyone.
			</p>
			<div class="compare-cards">
				<div class="compare-card">
					<h3>Blocks</h3>
					<Blocks class="compare-img" />
				</div>
				<div class="compare-card">
					<h3>TypeScript</h3>
					<TypeScript client:visible class="compare-code" />
				</div>
			</div>
			<p class="compare-note">
				<strong>Educational Value:</strong> By seeing the direct connection between blocks
				and code, learners quickly grasp programming concepts and syntax. Scrap is perfect
				for schools, workshops, and self-learners alike!
			</p>
		</div>
	</section>

	<footer>
		<div class="container">
			<p>
				&copy; 2025
				<a href={author.url} target="_blank" rel="noopener">{author.name}</a>. Under the
				<a href="https://opensource.org/license/mit" target="_blank" rel="noopener"
					>MIT License</a
				>.
			</p>
		</div>
	</footer>
</Layout>
