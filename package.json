{
	"name": "scrap",
	"displayName": "Scrap",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
	},
	"devDependencies": {
		"@eslint/js": "^9.35.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@swc/types": "^0.1.25",
		"@tailwindcss/vite": "^4.1.13",
		"@tsconfig/svelte": "^5.0.5",
		"@types/common-tags": "^1.8.4",
		"@types/node": "^24.3.1",
		"eslint": "^9.35.0",
		"eslint-plugin-svelte": "^3.12.2",
		"fast-xml-parser": "^5.2.5",
		"jiti": "^2.5.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"rollup": "^4.50.1",
		"shiki": "^3.12.2",
		"svelte": "^5.38.8",
		"svelte-check": "^4.3.1",
		"svelte-eslint-parser": "^1.3.1",
		"tailwindcss": "^4.1.13",
		"tsx": "^4.20.6",
		"typescript": "~5.9.2",
		"typescript-eslint": "^8.43.0",
		"vite": "^7.1.5"
	},
	"prettier": {
		"arrowParens": "avoid",
		"useTabs": true,
		"bracketSpacing": false,
		"tabWidth": 4,
		"printWidth": 96,
		"quoteProps": "consistent",
		"plugins": [
			"prettier-plugin-svelte"
		],
		"overrides": [
			{
				"files": [
					"*.yml",
					"*.yaml"
				],
				"options": {
					"useTabs": false,
					"tabWidth": 2
				}
			}
		]
	},
	"dependencies": {
		"@blockly/field-date": "^10.0.2",
		"@swc/wasm": "^1.13.5",
		"blockly": "^12.3.0",
		"clsx": "^2.1.1",
		"common-tags": "^1.8.2",
		"daisyui": "^5.1.9",
		"jszip": "^3.10.1",
		"monaco-editor": "^0.53.0"
	},
	"packageManager": "pnpm@10.12.4"
}
