{
	"name": "scrap-native",
	"private": true,
	"type": "module",
	"version": "0.0.0",
	"author": {
		"name": "Tomáš Wróbel",
		"email": "mail@tomaswrobel.dev",
		"url": "https://tomaswrobel.dev"
	},
	"dependencies": {
		"@blockly/field-angle": "5.0.12",
		"@blockly/field-colour-hsv-sliders": "5.0.12",
		"@blockly/field-date": "9.0.12",
		"@parcel/service-worker": "2.13.3",
		"@tauri-apps/api": "2.1.1",
		"@tauri-apps/plugin-dialog": "2.2.0",
		"@tauri-apps/plugin-fs": "2.2.0",
		"blockly": "11.2.0",
		"jszip": "3.10.1",
		"monaco-editor": "0.52.2",
		"process": "0.11.10",
		"scrap-engine": "2.5.3",
		"typescript": "5.7.2",
		"wavesurfer.js": "7.8.11"
	},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@parcel/config-default": "2.13.3",
		"@parcel/core": "2.13.3",
		"@parcel/packager-raw-url": "2.13.3",
		"@parcel/reporter-static-files": "npm:parcel-reporter-static-files-copy@1.5.3",
		"@parcel/resolver-glob": "2.13.3",
		"@parcel/transformer-sass": "2.13.3",
		"@parcel/transformer-webmanifest": "2.13.3",
		"@swc/types": "0.1.17",
		"@tauri-apps/cli": "2.1.0",
		"@types/node": "22.10.2",
		"buffer": "6.0.3",
		"csstype": "3.1.3",
		"eslint": "9.17.0",
		"keep-a-changelog": "2.5.3",
		"parcel": "2.13.3",
		"path-browserify": "1.0.1",
		"sass": "1.83.0",
		"svgo": "3.3.2",
		"typescript-eslint": "8.19.0"
	},
	"staticFiles": {
		"staticPath": "node_modules/blockly/media",
		"staticOutPath": "blockly-media"
	},
	"@parcel/resolver-default": {
		"packageExports": true
	},
	"scripts": {
		"icon": "tauri icon src/svgs/icon.svg --ios-color #2fbf71",
		"build": "parcel build index.html --no-source-maps",
		"dev": "parcel serve index.html",
		"lint": "tsc && eslint src/**/*.ts"
	},
	"alias": {
		"@scrap/*": "./src/$1",
		"@blockly/field-angle": "@blockly/field-angle/src/field_angle.ts",
		"@blockly/field-color": "@blockly/field-colour-hsv-sliders/src/field_colour_hsv_sliders.ts",
		"./node_modules/monaco-editor/esm/vs/base/common/platform.js": "./src/monaco-editor/platform.ts",
		"./node_modules/monaco-editor/esm/vs/editor/editor.main.js": "monaco-editor/esm/vs/editor/edcore.main.js",
		"./node_modules/blockly/index.mjs": "./node_modules/blockly/blockly_compressed.js"
	},
	"packageManager": "pnpm@9.15.0"
}
