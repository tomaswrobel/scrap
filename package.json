		"typescript": "~5.9.3",
		"vite": "^7.1.12",
		"vite-plugin-wasm": "^3.5.0"
	},
	"prettier": {
		"arrowParens": "avoid",
		"useTabs": true,
		"bracketSpacing": false,
		"tabWidth": 4,
		"printWidth": 96,
		"quoteProps": "consistent",
		"plugins": [
			"prettier-plugin-svelte"
		],
		"overrides": [
			{
				"files": [
					"*.yml",
					"*.yaml"
				],
				"options": {
					"useTabs": false,
					"tabWidth": 2
				}
			}
		]
	},
	"dependencies": {
		"@blockly/field-angle": "^6.0.3",
