{
	"name": "scrap",
	"displayName": "Scrap",
	"private": true,
	"version": "8.0.1",
	"license": "MIT",
	"type": "module",
	"author": {
		"name": "Tomáš Wróbel",
		"email": "mail@tomaswrobel.dev",
		"url": "https://tomaswrobel.dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/tomaswrobel/scrap"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.6",
		"@astrojs/svelte": "^7.2.5",
		"@astrojs/vercel": "^9.0.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@swc/types": "^0.1.25",
		"@tailwindcss/vite": "^4.1.18",
		"@tsconfig/svelte": "^5.0.6",
		"@types/common-tags": "^1.8.4",
		"@types/file-saver": "^2.0.7",
		"@types/node": "^25.0.6",
		"astro": "^5.16.8",
		"fast-xml-parser": "^5.3.3",
		"jiti": "^2.6.1",
		"oxlint": "^1.38.0",
		"oxlint-tsgolint": "^0.11.0",
		"prettier": "^3.7.4",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-svelte": "^3.4.1",
		"rollup": "^4.55.1",
		"shiki": "^3.21.0",
		"svelte": "^5.46.1",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^4.1.18",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-plugin-wasm": "^3.5.0"
	},
	"dependencies": {
		"@blockly/field-angle": "^6.0.7",
		"@blockly/field-colour-hsv-sliders": "^6.0.10",
		"@blockly/field-date": "^10.0.7",
		"@fontsource/geist": "^5.2.8",
		"@juvofy/lib": "github:Juvofy/base",
		"@material-symbols/svg-400": "^0.40.2",
		"@swc/wasm": "^1.15.8",
		"blockly": "^12.3.1",
		"clsx": "^2.1.1",
		"common-tags": "^1.8.2",
		"daisyui": "^5.5.14",
		"file-saver": "^2.0.5",
		"jszip": "^3.10.1",
		"monaco-editor": "^0.55.1",
		"painterro": "^1.2.92",
		"path-browserify-esm": "^1.0.6",
		"semver-parser": "^4.1.8",
		"wavesurfer.js": "^7.12.1"
	},
	"packageManager": "yarn@1.22.0",
	"prettier": {
		"arrowParens": "avoid",
		"useTabs": true,
		"bracketSpacing": false,
		"tabWidth": 4,
		"printWidth": 96,
		"quoteProps": "consistent",
		"plugins": [
			"prettier-plugin-svelte",
			"prettier-plugin-astro"
		],
		"overrides": [
			{
				"files": [
					"*.yml",
					"*.yaml"
				],
				"options": {
					"useTabs": false,
					"tabWidth": 2
				}
			},
			{
				"files": [
					"*.astro"
				],
				"options": {
					"parser": "astro"
				}
			},
			{
				"files": [
					".svelte"
				],
				"options": {
					"parser": "svelte"
				}
			}
		]
	}
}
