import Layout from "@scrap/components/Layout.astro";
import Navbar from "@scrap/components/Navbar.astro";
import Footer from "@scrap/components/Footer.astro";
import DocsSidebar from "@scrap/components/DocsSidebar.astro";
import {buildDocsCategories} from "@scrap/blockly/docs";

interface Props {
	active?: string;
}

const {active}: Props = Astro.props;
const categories = buildDocsCategories();
---

<Layout>
	<Navbar />
	<div class="navbar"></div>
	<section class="flex flex-col gap-6 p-4 md:p-8 bg-base-200 min-h-screen">
		<slot name="header" />
		<div class="flex gap-8 items-start">
			<DocsSidebar categories={categories} active={active} />
			<div class="flex-1 flex flex-col gap-4">
				<slot />
			</div>
		</div>
	</section>
	<Footer />
</Layout>
