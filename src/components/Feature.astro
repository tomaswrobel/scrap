---
import type {HTMLAttributes} from "astro/types";

export interface Props extends HTMLAttributes<"li"> {
	title: string;
	note: string;
}

const {
	"class:list": customClasses,
	"class": customClass,
	title,
	note,
	...props
}: Props = Astro.props;
---

<li {...props} class:list={[customClasses, customClass, "list-row"]}>
	<div>
		<div class="size-10 rounded-box bg-primary flex items-center justify-center">
			<slot name="icon" />
		</div>
	</div>
	<div class="sm:contents flex flex-col gap-4">
		<div>
			<h3>{title}</h3>
			<div class="text-xs uppercase font-semibold opacity-60">
				{note}
			</div>
		</div>
		<div class="sm:max-w-xs">
			<slot name="description" />
		</div>
	</div>
</li>
