{
	"tailwindCSS.classAttributes": ["class", "class:list"],
	"tailwindCSS.classFunctions": ["tw", "tw.map"],
	"typescript.tsdk": "node_modules/typescript/lib",
	"yaml.schemas": {
		"https://taskfile.dev/schema.json": [
			"Taskfile.{yml,yaml}",
			"taskfile.{yml,yaml}",
			"Taskfile.dist.{yml,yaml}",
			"taskfile.dist.{yml,yaml}"
		]
	},
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"typescript.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyBrackets": false,
	"svelte.plugin.typescript.enable": true,
	"svelte.enable-ts-plugin": true,
	"oxc.typeAware": true,
	"rust-analyzer.linkedProjects": ["./src/compiler/Cargo.toml"]
}
